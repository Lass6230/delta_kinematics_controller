<?xml version="1.0"?>
<package format="3">
  <name>delta_kinematics_controller</name>
  <version>0.1.0</version>
  <description>ros2_control controller plugin that uses kinematics_interface_delta to convert Cartesian commands to joint commands</description>
  <maintainer email="you@example.com">your name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>controller_interface</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>kinematics_interface</build_depend>
  <build_depend>kinematics_interface_delta</build_depend>
  <build_depend>Eigen3</build_depend>
  <build_depend>hardware_interface</build_depend>
  <depend>realtime_tools</depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>controller_interface</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>kinematics_interface</exec_depend>
  <exec_depend>kinematics_interface_delta</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>controller_manager</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <controller_plugins>resource/delta_kinematics_controller_plugins.xml</controller_plugins>
    <build_type>ament_cmake</build_type>
  </export>
</package>
