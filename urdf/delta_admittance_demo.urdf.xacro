<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="delta_robot">

  <!-- Parameters -->
  <xacro:property name="use_fake_hardware" value="true" />

  <!-- Base link (world frame) -->
  <link name="base_link">
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
  </link>

  <!-- Upper arm joints (3 revolute joints at 120 degrees) -->
  <xacro:property name="motor_offset" value="-0.025"/>
  <xacro:property name="base_radius" value="0.15"/>
  
  <!-- Joint 1 (0 degrees) -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm_1"/>
    <origin xyz="${base_radius} 0 ${motor_offset}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="10.0" velocity="2.0"/>
  </joint>

  <link name="upper_arm_1">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0.087 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0.087 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.174 0.02 0.02"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0 0 1"/>
      </material>
    </visual>
  </link>

  <!-- Joint 2 (120 degrees) -->
  <joint name="joint2" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm_2"/>
    <origin xyz="${-base_radius*0.5} ${base_radius*0.866} ${motor_offset}" rpy="0 0 ${2*pi/3}"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="10.0" velocity="2.0"/>
  </joint>

  <link name="upper_arm_2">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0.087 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0.087 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.174 0.02 0.02"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.8 0 1"/>
      </material>
    </visual>
  </link>

  <!-- Joint 3 (240 degrees) -->
  <joint name="joint3" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm_3"/>
    <origin xyz="${-base_radius*0.5} ${-base_radius*0.866} ${motor_offset}" rpy="0 0 ${4*pi/3}"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="10.0" velocity="2.0"/>
  </joint>

  <link name="upper_arm_3">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0.087 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0.087 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.174 0.02 0.02"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
  </link>

  <!-- Passive joints for lower arms (elbow pitch and yaw) -->
  <!-- Arm 1 passive joints -->
  <link name="elbow_1">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="elbow_joint_1" type="fixed">
    <parent link="upper_arm_1"/>
    <child link="elbow_1"/>
    <origin xyz="0.17438 0 0" rpy="0 0 0"/>
  </joint>

  <link name="lower_pitch_link_1"/>

  <joint name="elbow_pitch_1" type="continuous">
    <parent link="elbow_1"/>
    <child link="lower_pitch_link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="lower_link_1">
    <visual>
      <geometry>
        <cylinder length="0.34" radius="0.008"/>
      </geometry>
      <origin xyz="-0.17 0 0" rpy="0 1.5707963268 0"/>
      <material name="green">
        <color rgba="0.2 0.8 0.4 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="elbow_yaw_1" type="continuous">
    <parent link="lower_pitch_link_1"/>
    <child link="lower_link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="lower_arm_end_1">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="lower_arm_end_joint_1" type="fixed">
    <parent link="lower_link_1"/>
    <child link="lower_arm_end_1"/>
    <origin xyz="-0.34 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Arm 2 passive joints -->
  <link name="elbow_2">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="elbow_joint_2" type="fixed">
    <parent link="upper_arm_2"/>
    <child link="elbow_2"/>
    <origin xyz="0.17438 0 0" rpy="0 0 0"/>
  </joint>

  <link name="lower_pitch_link_2"/>

  <joint name="elbow_pitch_2" type="continuous">
    <parent link="elbow_2"/>
    <child link="lower_pitch_link_2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="lower_link_2">
    <visual>
      <geometry>
        <cylinder length="0.34" radius="0.008"/>
      </geometry>
      <origin xyz="-0.17 0 0" rpy="0 1.5707963268 0"/>
      <material name="green">
        <color rgba="0.2 0.8 0.4 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="elbow_yaw_2" type="continuous">
    <parent link="lower_pitch_link_2"/>
    <child link="lower_link_2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="lower_arm_end_2">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="lower_arm_end_joint_2" type="fixed">
    <parent link="lower_link_2"/>
    <child link="lower_arm_end_2"/>
    <origin xyz="-0.34 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Arm 3 passive joints -->
  <link name="elbow_3">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="elbow_joint_3" type="fixed">
    <parent link="upper_arm_3"/>
    <child link="elbow_3"/>
    <origin xyz="0.17438 0 0" rpy="0 0 0"/>
  </joint>

  <link name="lower_pitch_link_3"/>

  <joint name="elbow_pitch_3" type="continuous">
    <parent link="elbow_3"/>
    <child link="lower_pitch_link_3"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="lower_link_3">
    <visual>
      <geometry>
        <cylinder length="0.34" radius="0.008"/>
      </geometry>
      <origin xyz="-0.17 0 0" rpy="0 1.5707963268 0"/>
      <material name="green">
        <color rgba="0.2 0.8 0.4 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="elbow_yaw_3" type="continuous">
    <parent link="lower_pitch_link_3"/>
    <child link="lower_link_3"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="lower_arm_end_3">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="lower_arm_end_joint_3" type="fixed">
    <parent link="lower_link_3"/>
    <child link="lower_arm_end_3"/>
    <origin xyz="-0.34 0 0" rpy="0 0 0"/>
  </joint>

  <!-- End effector link -->
  <link name="end_effector">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="yellow">
        <color rgba="1 0.8 0 1"/>
      </material>
    </visual>
  </link>

  <!-- Floating joint: the delta kinematics controller broadcasts
       the true base_link→end_effector transform on /tf at runtime. -->
  <joint name="ee_floating" type="floating">
    <parent link="base_link"/>
    <child link="end_effector"/>
  </joint>

  <!-- ros2_control configuration -->
  <!-- Mock hardware for joints -->
  <ros2_control name="MockJointHardware" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="calculate_dynamics">false</param>
      <param name="position_state_following_offset">0.0</param>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <!-- Network FT Sensor Configuration -->
  <xacro:arg name="ip_address" default="192.168.1.1" />
  <xacro:arg name="rdt_sampling_rate" default="500" />
  <xacro:arg name="sensor_type" default="ati_axia" />
  <xacro:arg name="internal_filter_rate" default="1" />
  <xacro:arg name="use_hardware_biasing" default="true" />

  <!-- Include network FT sensor xacro macros -->
  <xacro:include filename="$(find net_ft_description)/urdf/net_ft_sensor_macro.urdf.xacro" />
  <xacro:net_ft_sensor
    parent="end_effector"
    prefix=""
    ip_address="$(arg ip_address)"
    rdt_sampling_rate="$(arg rdt_sampling_rate)"
    sensor_type="$(arg sensor_type)"
    internal_filter_rate="$(arg internal_filter_rate)"
    use_hardware_biasing="$(arg use_hardware_biasing)">
      <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:net_ft_sensor>

  <!-- ros2_control configuration for network FT sensor -->
  <xacro:include filename="$(find net_ft_description)/urdf/net_ft_sensor.ros2_control.xacro" />
  <xacro:net_ft_sensor_ros2_control
    name="NetFtHardwareInterface"
    ip_address="$(arg ip_address)"
    rdt_sampling_rate="$(arg rdt_sampling_rate)"
    sensor_type="$(arg sensor_type)"
    internal_filter_rate="$(arg internal_filter_rate)"
    use_hardware_biasing="$(arg use_hardware_biasing)"/>

</robot>
