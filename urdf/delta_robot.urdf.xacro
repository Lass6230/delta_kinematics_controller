<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="delta_robot">
  <!-- Simple visualization URDF for the delta demo.
       This is not a kinematically-closed URDF — it's a visualization aid.
       The controller will publish the true end-effector TF on /tf (child 'ee'). -->

  <xacro:property name="delta_e" value="0.045"/>
  <xacro:property name="delta_f" value="0.11812"/>
  <xacro:property name="delta_re" value="0.34"/>
  <xacro:property name="delta_rf" value="0.17438"/>
  <xacro:property name="delta_motor_z_offset" value="-0.025"/>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
  <origin xyz="0 0 ${delta_motor_z_offset}" rpy="0 0 0"/>
      <material name="gray"><color rgba="0.6 0.6 0.6 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
      <origin xyz="0 0 ${delta_motor_z_offset}" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Three simple revolute joints and arms for visualization -->
  <xacro:macro name="arm" params="idx x y yaw">
    <!-- Upper arm (connected to motor) -->
    <link name="upper_link_${idx}">
      <visual>
        <geometry>
          <cylinder length="${delta_rf}" radius="0.01"/>
        </geometry>
        <!-- Cylinder rotated to lie horizontally for Z-axis rotation -->
        <origin xyz="${delta_rf/2.0} 0 0" rpy="0 ${pi/2} 0"/>
        <material name="blue"><color rgba="0.2 0.4 0.8 1.0"/></material>
      </visual>
      <collision>
        <geometry>
          <cylinder length="${delta_rf}" radius="0.01"/>
        </geometry>
        <origin xyz="${delta_rf/2.0} 0 0" rpy="0 ${pi/2} 0"/>
      </collision>
    </link>

    <joint name="joint${idx}" type="revolute">
      <parent link="base_link"/>
      <child link="upper_link_${idx}"/>
      <!-- Rotate around local Y axis (perpendicular to radial direction)
           This allows the arm to swing up/down in the radial plane
           The rpy="0 0 ${yaw}" rotates the entire joint frame so Y is tangent -->
      <origin xyz="${x} ${y} ${delta_motor_z_offset}" rpy="0 0 ${yaw}"/>
      <axis xyz="0 1 0"/>
      <limit effort="10.0" velocity="10.0" lower="-3.1416" upper="3.1416"/>
    </joint>

    <!-- Elbow joint (virtual, for visualization only) -->
    <link name="elbow_${idx}">
      <visual>
        <geometry>
          <sphere radius="0.015"/>
        </geometry>
        <material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.015"/>
        </geometry>
      </collision>
    </link>

    <joint name="elbow_joint_${idx}" type="fixed">
      <parent link="upper_link_${idx}"/>
      <child link="elbow_${idx}"/>
      <origin xyz="${delta_rf} 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Ball joint intermediate link for pitch rotation -->
    <link name="lower_pitch_link_${idx}"/>

    <!-- Ball joint pitch: rotation around Y axis -->
    <joint name="elbow_pitch_${idx}" type="continuous">
      <parent link="elbow_${idx}"/>
      <child link="lower_pitch_link_${idx}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>  <!-- Pitch around Y axis -->
    </joint>

    <!-- Lower arm (forearm, connected to end-effector via ball joint) -->
    <link name="lower_link_${idx}">
      <visual>
        <geometry>
          <cylinder length="${delta_re}" radius="0.008"/>
        </geometry>
        <!-- cylinder centered at origin, extends along -X (toward EE) -->
        <origin xyz="${-delta_re/2.0} 0 0" rpy="0 ${pi/2} 0"/>
        <material name="green"><color rgba="0.2 0.8 0.4 1.0"/></material>
      </visual>
      <collision>
        <geometry>
          <cylinder length="${delta_re}" radius="0.008"/>
        </geometry>
        <origin xyz="${-delta_re/2.0} 0 0" rpy="0 ${pi/2} 0"/>
      </collision>
    </link>

    <!-- Ball joint yaw: rotation around Z axis (after pitch) -->
    <joint name="elbow_yaw_${idx}" type="continuous">
      <parent link="lower_pitch_link_${idx}"/>
      <child link="lower_link_${idx}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>  <!-- Yaw around Z axis (after pitch rotation) -->
    </joint>

    <!-- End point of lower arm (where it attaches to EE platform) -->
    <link name="lower_arm_end_${idx}">
      <visual>
        <geometry>
          <sphere radius="0.012"/>
        </geometry>
        <material name="gray"><color rgba="0.5 0.5 0.5 1.0"/></material>
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.012"/>
        </geometry>
      </collision>
    </link>

    <joint name="lower_arm_end_joint_${idx}" type="fixed">
      <parent link="lower_link_${idx}"/>
      <child link="lower_arm_end_${idx}"/>
      <origin xyz="${-delta_re} 0 0" rpy="0 0 0"/>  <!-- At the end of the lower arm (in -X direction) -->
    </joint>
  </xacro:macro>

  <!-- instantiate three arms at 0, 120, 240 degrees -->
  <!-- positions on base rim at radius 0.06 -->
  <!-- FK convention: arm 1 extends in -Y direction (0°), then 120°, 240° -->
  <!-- Yaw rotates the joint frame so local X-axis points along the arm direction -->
  <xacro:arm idx="1" x="0.0" y="-0.06" yaw="-1.57079632679"/>
  <xacro:arm idx="2" x="0.051961524" y="0.03" yaw="0.52359877559"/>
  <xacro:arm idx="3" x="-0.051961524" y="0.03" yaw="2.61799387799"/>

  <!-- End-effector frame (visual only) -->
  <link name="ee">
    <visual>
      <geometry>
        <sphere radius="${delta_e}"/>
      </geometry>
      <material name="red"><color rgba="0.8 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${delta_e}"/>
      </geometry>
    </collision>
  </link>

  <!-- Floating joint — robot_state_publisher ignores this;
       the delta kinematics controller broadcasts the EE TF directly. -->
  <joint name="ee_joint" type="floating">
    <parent link="base_link"/>
    <child link="ee"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Visual markers for EE platform attachment points (actual lower arm end positions) -->
  <!-- These should match where the lower_arm_end markers are positioned -->
  <link name="ee_attach_1"/>  <!-- No visual - disabled to reduce clutter -->
  
  <joint name="ee_attach_joint_1" type="fixed">
    <parent link="ee"/>
    <child link="ee_attach_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="ee_attach_2"/>  <!-- No visual - disabled -->
  
  <joint name="ee_attach_joint_2" type="fixed">
    <parent link="ee"/>
    <child link="ee_attach_2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="ee_attach_3"/>  <!-- No visual - disabled -->
  
  <joint name="ee_attach_joint_3" type="fixed">
    <parent link="ee"/>
    <child link="ee_attach_3"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <origin xyz="${-delta_e * 0.866025404} ${-delta_e * 0.5} 0" rpy="0 0 0"/>  <!-- Arm 3 at 240° -->
  </joint>

  <!-- Inline a minimal ros2_control mock system so xacro does not need to resolve
       package names at launch time. This avoids failures when ros2 launch invokes
       xacro in environments where ament package discovery is not available. -->
  <ros2_control name="MockHardwareSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="calculate_dynamics">false</param>
      <param name="position_state_following_offset">0.0</param>
      <param name="mock_sensor_commands">false</param>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Fake Force-Torque Sensor for Admittance Control -->
    <sensor name="tcp_fts_sensor">
      <state_interface name="force.x"/>
      <state_interface name="force.y"/>
      <state_interface name="force.z"/>
      <state_interface name="torque.x"/>
      <state_interface name="torque.y"/>
      <state_interface name="torque.z"/>
      <param name="frame_id">end_effector</param>
    </sensor>

  </ros2_control>

</robot>
